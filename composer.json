{
  "name": "bogdancondorachi/kirby-table-field",
  "description": "Table field plugin for Kirby CMS",
  "type": "kirby-plugin",
  "version": "2.5.0",
  "license": "MIT",
  "homepage": "https://getkirby.com/plugins/bogdancondorachi/table-field",
  "authors": [
    {
      "name": "Bogdan Condorachi",
      "email": "bogdan.condorachi@gmail.com",
      "homepage": "https://getkirby.com/plugins/bogdancondorachi"
    }
  ],
  "require": {
    "php": ">=8.3.0",
    "getkirby/composer-installer": "^1.2"
  },
  "require-dev": {
    "getkirby/cms": "^4.0 || ^5.0"
  },
  "conflict": {
    "getkirby/cms": "<4.0 || >=6.0"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "extra": {
    "kirby": {
      "compatible": "^4.0 || ^5.0"
    },
    "kirby-cms-path": false,
    "installer-name": "table-field"
  }
}
